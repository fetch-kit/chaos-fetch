{
  "name": "@fetchkit/chaos-fetch",
  "version": "1.2.3",
  "description": "Client-side chaos-testing library for JavaScript/TypeScript apps.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fetch-kit/chaos-fetch.git"
  },
  "homepage": "https://github.com/fetch-kit/chaos-fetch#readme",
  "bugs": "https://github.com/fetch-kit/chaos-fetch/issues",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest --watch",
    "prepare": "husky",
    "test:ci": "vitest --run --coverage",
    "obs:up": "docker compose -f docker/observability/docker-compose.yml up -d",
    "obs:down": "docker compose -f docker/observability/docker-compose.yml down --remove-orphans",
    "obs:logs": "docker compose -f docker/observability/docker-compose.yml logs -f otel-collector jaeger prometheus grafana",
    "obs:validate": "docker compose -f docker/observability/docker-compose.yml config",
    "obs:reset": "docker compose -f docker/observability/docker-compose.yml down -v --remove-orphans",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write .",
    "changeset": "changeset",
    "version": "changeset version",
    "prepublishOnly": "npm run build && npm run test:ci"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "chaos",
    "fetch",
    "testing",
    "typescript"
  ],
  "author": "Gabor Koos <gabor@gaborkoos.com>",
  "license": "MIT",
  "dependencies": {
    "@koa/router": "^15.5.0",
    "koa-compose": "^4.1.0",
    "lru-cache": "^11.2.7"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@types/koa__router": "^12.0.4",
    "@types/koa-compose": "^3.2.8",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.9.0",
    "husky": "^9.1.7",
    "prettier": "^3.2.5",
    "tsup": "^8.5.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}
